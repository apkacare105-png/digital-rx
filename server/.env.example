# ---- Server ----
NODE_ENV=development
PORT=5000
# 0.0.0.0 = accept connections on all interfaces (use 127.0.0.1 to allow this computer only)
HOST=0.0.0.0
CLIENT_URL=http://localhost:5173
# Public address of the site (kept for reference; the QR code on the PDF uses the address in the browser)
PUBLIC_APP_URL=http://localhost:5173

# ---- Production / deployment ----
# Cookies are HTTPS-only in production. Set false ONLY to test a production build over plain http.
# COOKIE_SECURE=false
# Serve client/dist from this server (default true when the folder exists)
# SERVE_CLIENT=true

# ---- Database ----
MONGO_URI=mongodb://127.0.0.1:27017/digital_rx
# For Atlas: mongodb+srv://user:pass@cluster.mongodb.net/digital_rx
# Force Google DNS at boot to fix Atlas SRV lookup failures on some ISPs (e.g. Jio). Empty = system DNS.
DNS_SERVERS=8.8.8.8,8.8.4.4

# ---- JWT (generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ----
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7

# ---- Auth behaviour ----
BCRYPT_ROUNDS=12
PASSWORD_RESET_EXPIRES_MIN=30

# ---- Uploads (logo / signature) ----
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=2

# ---- Email (forgot password). Leave blank in dev: reset link is logged to console ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Digital Rx <no-reply@example.com>"

# ---- Seed script ----
SEED_ADMIN_NAME=Platform Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe@12345
