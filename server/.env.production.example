# Copy to server/.env on the production server and fill in EVERY value.
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# Your real public address (https). The React app is served by this same server.
CLIENT_URL=https://rx.yourdomain.com
PUBLIC_APP_URL=https://rx.yourdomain.com

# Database (self-hosted MongoDB, or Atlas mongodb+srv://...)
MONGO_URI=mongodb://127.0.0.1:27017/digital_rx
# Leave empty on a server with working DNS. Set 8.8.8.8,8.8.4.4 only if Atlas SRV lookups fail.
DNS_SERVERS=

# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7

BCRYPT_ROUNDS=12
PASSWORD_RESET_EXPIRES_MIN=30

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=2

# Email (needed for "forgot password"). Example: Gmail app password, Brevo, SES, or your cPanel mail account.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Digital Rx <no-reply@yourdomain.com>"

# Used only by: npm run seed  (use a strong password; the seed refuses the default in production)
SEED_ADMIN_NAME=Platform Admin
SEED_ADMIN_EMAIL=admin@yourdomain.com
SEED_ADMIN_PASSWORD=
